generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ReadingStatus {
  TO_READ
  READING
  COMPLETED
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  name         String?
  passwordHash String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  savedWorks   SavedWork[]
  collections  Collection[]
}

model SavedWork {
  id              String           @id @default(uuid())
  userId          String
  openAlexId      String
  title           String
  abstract        String?          @db.Text
  authors         Json
  topics          Json
  publicationYear Int?
  publicationType String?
  venue           String?
  citedByCount    Int              @default(0)
  isOpenAccess    Boolean          @default(false)
  doi             String?
  sourceUrl       String?
  status          ReadingStatus    @default(TO_READ)
  note            String?          @db.Text
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  collectionLinks CollectionWork[]

  @@unique([userId, openAlexId])
  @@index([userId, createdAt])
}

model Collection {
  id          String           @id @default(uuid())
  userId      String
  name        String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  works       CollectionWork[]

  @@unique([userId, name])
}

model CollectionWork {
  collectionId String
  savedWorkId  String
  createdAt    DateTime   @default(now())
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  savedWork    SavedWork  @relation(fields: [savedWorkId], references: [id], onDelete: Cascade)

  @@id([collectionId, savedWorkId])
}
